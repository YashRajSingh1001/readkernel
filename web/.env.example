# Website settings. Copy to web/.env.local.
# Leave both blank to read the pipeline's local files (../pipeline/data).

# Supabase -> Project Settings -> API
SUPABASE_URL=
# The publishable (or legacy "anon") key. Read-only thanks to Row Level Security.
SUPABASE_PUBLISHABLE_KEY=

# Optional: where to find local briefs when Supabase is not set
# LOCAL_DATA_DIR=../pipeline/data

# --- Newsletter sign-up (server-side only; never prefix these with NEXT_PUBLIC_) ---
# Secret key: needed to save subscribers. Same value as the pipeline's .env.
SUPABASE_SECRET_KEY=
# Public address of the site, used in confirmation links
SITE_URL=http://localhost:3000
# preview (print to server log) | smtp | resend. Same meaning as the pipeline's settings.
EMAIL_TRANSPORT=preview
# EMAIL_FROM=ReadKernel <you@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=          # a Gmail "app password", not your normal password
# RESEND_API_KEY=

# --- Sign-in (optional; off until NEXT_PUBLIC_AUTH_ENABLED=1) ---
# Same project URL and publishable key as above. They are public by design
# (safe in the browser); Row Level Security protects the data.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_AUTH_ENABLED=1

# Address shown on the contact and privacy pages
# NEXT_PUBLIC_CONTACT_EMAIL=readkernel.brief@gmail.com

# Local testing only: read pipeline/data JSON even when Supabase is configured
# READ_LOCAL_DATA=1
