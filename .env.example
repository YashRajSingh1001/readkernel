# ReadKernel settings. Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# AI provider: groq (default, free tier) | claude | openai | none
# "none" runs the whole pipeline without any AI (summaries fall back to the
# feed's own description). Claude and OpenAI are paid; keep them off unless
# you want them.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Open-weight models on Groq: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional, paid
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# Ignore articles older than this
# MAX_AGE_HOURS=36
# How many stories go into the brief
# STORIES_PER_BRIEF=10
# Story grouping: "local" embeddings (free, runs on your machine) or "simple"
# word-overlap matching (no model download, less accurate)
# EMBEDDINGS=local
# Which day a brief belongs to
# TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database (optional). Without these the brief is only saved as local JSON.
# Supabase -> Project Settings -> API. The secret key can write: keep it
# server-side only (pipeline / GitHub Actions secrets), never in the website.
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# Read-only key for the MCP server (pipeline/kernel/mcp_server.py); the same
# publishable key the website uses. The MCP server never uses the secret key.
# SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Daily email
#   preview  (default) save emails to pipeline/data/outbox/ and send nothing
#   smtp     Gmail works free: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an
#            app password (Google Account -> Security -> App passwords)
#   resend   Resend API, free 3,000/month; needs your own domain
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=preview
# EMAIL_FROM=ReadKernel <you@gmail.com>
# Where readers' replies go (handy when EMAIL_FROM can't receive mail)
# EMAIL_REPLY_TO=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# RESEND_API_KEY=
# Public website address, used for links in emails
SITE_URL=http://localhost:3000
# Throttle so Gmail doesn't flag the account
# SEND_PER_MINUTE=20

# ---------------------------------------------------------------------------
# More options
# ---------------------------------------------------------------------------
# Stories saved per day for the feed (the top STORIES_PER_BRIEF make the brief)
# FEED_SIZE=30
# Telegram channel posting (free). Create a bot with @BotFather, add it to your
# channel as an admin, then set both:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=@yourchannel
