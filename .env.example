# ReadKernel settings, for the pipeline and the website. Copy to .env (in this
# folder) and fill in. Never commit .env. The website reads this same file
# (see web/next.config.ts); on Vercel, set its settings there instead.

# ---------------------------------------------------------------------------
# AI provider: groq (default, free tier) | claude | openai | none
# "none" runs the whole pipeline without any AI (summaries fall back to the
# feed's own description). Claude and OpenAI are paid; keep them off unless
# you want them.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Open-weight models on Groq: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional, paid
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-5-mini
# (OPENAI_API_KEY is in the website section below. The pipeline only uses it
# when LLM_PROVIDER=openai.)

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# Ignore articles older than this
# MAX_AGE_HOURS=36
# How many stories go into the brief
# STORIES_PER_BRIEF=10
# Story grouping: "local" embeddings (free, runs on your machine) or "simple"
# word-overlap matching (no model download, less accurate)
# EMBEDDINGS=local
# Which day a brief belongs to (the website uses it too, for Ask's "today")
# TIMEZONE=Asia/Kolkata
# Where the source list and the local output live. Defaults: pipeline/sources.yaml
# and pipeline/data. To change them, give full paths.
# SOURCES_FILE=
# DATA_DIR=

# ---------------------------------------------------------------------------
# Database (optional). Without these the brief is only saved as local JSON.
# Supabase -> Project Settings -> API. The secret key can write: keep it
# server-side only (pipeline / GitHub Actions secrets), never in the website.
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# Read-only key for the MCP server (pipeline/kernel/mcp_server.py); the same
# publishable key the website uses. The MCP server never uses the secret key.
# SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Daily email
#   preview  (default) save emails to pipeline/data/outbox/ and send nothing
#   smtp     Gmail works free: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an
#            app password (Google Account -> Security -> App passwords)
#   resend   Resend API, free 3,000/month; needs your own domain
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=preview
# EMAIL_FROM=ReadKernel <you@gmail.com>
# Where readers' replies go (handy when EMAIL_FROM can't receive mail)
# EMAIL_REPLY_TO=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# RESEND_API_KEY=
# Public website address, used for links in emails
SITE_URL=http://localhost:3000
# Throttle so Gmail doesn't flag the account
# SEND_PER_MINUTE=20

# ---------------------------------------------------------------------------
# More options
# ---------------------------------------------------------------------------
# Stories saved per day for the feed (the top STORIES_PER_BRIEF make the brief)
# FEED_SIZE=30
# Telegram channel posting (free). Create a bot with @BotFather, add it to your
# channel as an admin, then set both:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=@yourchannel

# ---------------------------------------------------------------------------
# Website only. It also uses SUPABASE_URL, SUPABASE_SECRET_KEY (to save
# subscribers), SITE_URL and the email settings above.
# ---------------------------------------------------------------------------
# Supabase -> Project Settings -> API: the publishable (or legacy "anon") key.
# Read-only thanks to Row Level Security. Leave the Supabase settings blank to
# read the pipeline's local files (../pipeline/data) instead.
SUPABASE_PUBLISHABLE_KEY=
# LOCAL_DATA_DIR=../pipeline/data
# Local testing only: read pipeline/data JSON even when Supabase is configured
# READ_LOCAL_DATA=1

# Ask ReadKernel (the chat at /ask) runs on OpenAI and is off without this key.
OPENAI_API_KEY=
# ASK_MODEL=gpt-6-luna
# ASK_REASONING_EFFORT=medium     # low | medium | high
# ASK_WEB_SEARCH=on                # off: Ask uses only ReadKernel's own coverage, no web search
# ASK_CACHE=on                     # off: skip the shared answer table; read: use it but never write (local testing)
# AI_USAGE_LOG=on                  # off: don't save AI token counts to ai_usage (the log line still prints). Both programs read it.

# Where readers' replies to sign-up emails go (handy when EMAIL_FROM can't receive mail)
# EMAIL_REPLY_TO=you@gmail.com

# Sign-in (optional; off until NEXT_PUBLIC_AUTH_ENABLED=1). Same project URL and
# publishable key as above. They are public by design (safe in the browser);
# Row Level Security protects the data.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_AUTH_ENABLED=1

# Address shown on the contact and privacy pages
# NEXT_PUBLIC_CONTACT_EMAIL=readkernel.brief@gmail.com
